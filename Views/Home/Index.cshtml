@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home | FavoRead</title>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
</head>
<body>
<header>
    <nav>
        <div class="menu">
            <a href="/"><img src="~/images/Logo.svg" class="logo" alt="logo"></a>

            <div class="nav-right-side">
                
                @if (SignInManager.IsSignedIn(User))
                {
                    <span class="user-greeting">Hello, @User.Identity.Name!</span>

                    @*SearchBar*@
                     <form asp-controller="Book" asp-action="Search" method="get" class="search-form">
                       <input type="text" name="query" placeholder="Search..." value="@ViewBag.SearchQuery">
                       <button type="submit" style="background:none; border:none; cursor:pointer; display:flex; align-items:center; padding:0;">
                       <ion-icon name="search-outline" style="color:#5CCCF9; font-size:22px;"></ion-icon>
                       </button>
                    </form>

                    @*Profile*@
                    @if (User.IsInRole("Author"))
                    {
                        <a href="/Author/Index" class="nav-icon"><ion-icon name="person-circle-outline"></ion-icon></a>
                    }
                    else if (User.IsInRole("Reader"))
                    {
                        <a href="/Reader/Index" class="nav-icon"><ion-icon name="person-circle-outline"></ion-icon></a>
                    }
                    <a class="nav-icon" href="/"><ion-icon name="home-outline"></ion-icon></a>
                    @*Log out*@
                    <a href="javascript:void(0)" id="logoutBtn" class="nav-icon"><ion-icon name="log-out-outline"></ion-icon></a>
                }
                else
                {
                    <a href="/Account/Login" class="logSignIn logIn">Log in</a>
                    <a href="/Account/Register" class="logSignIn signIn">Sign in</a>
                }

            </div>
        </div>
    </nav>
</header>


    <div class="quote-container">
    <img src="~/images/HomeIdex.svg" class="quote-logo" alt="logo">
        <blockquote class="modern-quote" id="quote-box">
            <p id="quote-text">"If you don't like to read, you haven't found the right book."</p>
            <footer class="author-name" id="author">—J.K. Rowling</footer>
        </blockquote>
</div>

<script>
    const quotes = [
        {
            text: '"If you don\'t like to read, you haven\'t found the right book."',
            author: "— J.K. Rowling"
        },
        {
            text: '"A reader lives a thousand lives before he dies... The man who never reads lives only one. "',
            author: "— George R.R. Martin"
        },
        {
            text: '"A book, too, can be a star, a living fire to lighten the darkness, leading out into the expanding universe."',
            author: "— Madeleine L\'Engle"
        },
                {
            text: '"I think books are like people, in the sense that they\'ll turn up in your life when you most need them."',
            author: "— Emma Thompson"
        },
        {
            text: '"Books are a uniquely portable magic."',
            author: "— Stephen King"
        },
        {
            text: '"I can feel infinitely alive curled up on the sofa reading a book."',
            author: "— Benedict Cumberbatch"
        },
        {
            text: '"Books and doors are the same thing. You open them, and you go through into another world."',
            author: "— Jane Austen"
        },
        {
            text: '"The love of books is among the choicest gifts of gods."',
            author: "— Sir Arthur Conan Doyle"
        },
        {
            text: "A mind needs books as a sword needs a whetstone, if it is to keep its edge",
            author :"- George R. R. Martin"
        },
        {
            text: "I declare after all there is no enjoyment like reading! How much sooner one tires of anything than of a book",
            author: "- Jane Austen"
        }
    ];

    let currentIndex = 0;
    const quoteBox = document.getElementById('quote-box');
    const textElem = document.getElementById('quote-text'); // Променено тук
    const authorElem = document.getElementById('author');

    function changeQuote() {
        // Добавяме класа за изчезване
        quoteBox.classList.add('fade-out');

        // Изчакваме 1 секунда (колкото трае анимацията в CSS)
        setTimeout(() => {
            currentIndex = (currentIndex + 1) % quotes.length;
            
            // Сменяме съдържанието
            textElem.textContent = quotes[currentIndex].text;
            authorElem.textContent = quotes[currentIndex].author;

            // Махаме класа, за да се появи новият цитат
            quoteBox.classList.remove('fade-out');
        }, 1000); 
    }

    // Сменяй на всеки 10 секунди
    setInterval(changeQuote, 10000);
</script>
    </div>

    @if (SignInManager.IsSignedIn(User))
    {
        <script>
            document.getElementById('logoutBtn').addEventListener('click', async () => {
                const response = await fetch('/Account/Logout', { method: 'POST' });
                if (response.ok) {
                    window.location.reload(); // Презарежда страницата, за да се скрие Logout бутона
                }
            });
        </script>
    }
<script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
<script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</body>
</html>