@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home | FavoRead</title>
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body>
    <header>
        <nav>
            <div class="menu">
                <img src="~/images/Logo.svg" class="logo" alt="logo">
                @if (SignInManager.IsSignedIn(User))
                {
                    @*Log out button*@
                    <a href="javascript:void(0)" id="logoutBtn" class="nav-icon"><ion-icon name="log-out-outline"></ion-icon></a>

                    @*Profile Role*@
                    @if (User.IsInRole("Author"))
                    {
                        <a href="/Author/Index" class="nav-icon"><ion-icon name="person-circle-outline"></ion-icon></a>
                    }
                    else if (User.IsInRole("Reader"))
                    {
                        <a href="/Reader/Index" class="nav-icon"><ion-icon name="person-circle-outline"></ion-icon></a>
                    }

                    @*SearchBar*@
                    <form asp-controller="Book" asp-action="Search" method="get" style="display: inline-flex; align-items: center;">
    <button type="submit" class="nav-icon" style="background:none; border:none; cursor:pointer; padding:0;">
        <ion-icon name="search-outline"></ion-icon>
    </button>
    <input type="text" name="query" placeholder="Search..." value="@ViewBag.SearchQuery">
</form>

                    @*User Greeting*@
                    <span class="user-greeting">Hello, @User.Identity.Name!</span>
                }
                else
                {
                    <a href="/Account/Login">Log in</a>
                    <a href="/Account/Register">Sign in</a>
                }

                <a class="active nav-icon" href="/"><ion-icon name="home-outline"></ion-icon></a>
            </div>
        </nav>
    </header>


    <div class="quote-container">
    <img src="~/images/Logo.svg" class="quote-logo" alt="logo">
        <blockquote class="modern-quote" id="quote-box">
            <p>"If you don't like to read, you haven't found the right book."</p>
            <footer class="author-name" id="author">—J.K. Rowling</footer>
        </blockquote>
<div class="quote-container">
    ...
</div>

<script>
    const quotes = [
        {
            text: '"If you don\'t like to read, you haven\'t found the right book."',
            author: "— J.K. Rowling"
        },
        {
            text: '"A room without books is like a body without a soul."',
            author: "— Marcus Tullius Cicero"
        },
        {
            text: '"Classic - a book which people praise and don\'t read."',
            author: "— Mark Twain"
        }
    ];

    let currentIndex = 0;
    const quoteBox = document.getElementById('quote-box');
    const textElem = document.getElementById('text');
    const authorElem = document.getElementById('author');

    function changeQuote() {
        quoteBox.classList.add('fade-out');

        setTimeout(() => {
            currentIndex = (currentIndex + 1) % quotes.length;
            textElem.textContent = quotes[currentIndex].text;
            authorElem.textContent = quotes[currentIndex].author;
            quoteBox.classList.remove('fade-out');
        }, 1000); 
    }

    setInterval(changeQuote, 15000);
</script>
    </div>

    @if (SignInManager.IsSignedIn(User))
    {
        <script>
            document.getElementById('logoutBtn').addEventListener('click', async () => {
                const response = await fetch('/Account/Logout', { method: 'POST' });
                if (response.ok) {
                    window.location.reload(); // Презарежда страницата, за да се скрие Logout бутона
                }
            });
        </script>
    }
<script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
<script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</body>
</html>