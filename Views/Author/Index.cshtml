@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@model FavoReads.Models.Author
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home | FavoRead</title>
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body>
    <header>
        <nav>
            <div class="menu">
                <img src="~/images/Logo.svg" class="logo" alt="logo">
                
                @if (SignInManager.IsSignedIn(User))
                {
                    <a href="javascript:void(0)" id="logoutBtn"><ion-icon name="log-out-outline"></ion-icon></a>
                    <span class="user-greeting">Hello, @User.Identity.Name!</span>
                }
                else
                {
                    <a href="/Account/Login">Log in</a>
                    <a href="/Account/Register">Sign in</a>
                }

                <a class="active" href="/">Home</a>
            </div>
        </nav>
    </header>
<main class="container author-page">
        <section class="author-header">
            <div class="author-profile">

                <img src=@(Model.ProfilePictureUrl)
                     onerror="this.src='/images/user-default.png'"
                     alt="Author" class="author-img">

                <div class="author-details">
                    <h1>@Model.FirstName @Model.LastName</h1>
                    <p class="author-email">@ViewBag.AuthorEmail</p>
                </div>

            <div class="author-actions">
                    <div class="button-group">
                        @* Промени бутона на линк към Book/AddBook *@
                        <a href="/Book/AddBook" class="btn btn-add" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
                            Add book <i class="fa-solid fa-pen-to-square"></i>
                        </a>
                        <button class="btn btn-settings"><i class="fa-solid fa-gear"></i></button>
                    </div>
                <div class="stats-card">
                    <div class="stat">
                            <span class="stat-value">@ViewBag.BooksCount</span>
                        <span class="stat-label">BOOKS</span>
                    </div>
                    
                </div>
            </div>
        </section>
        <section class="author-books" style="margin-top: 50px; padding: 0 20px;">
            <h2 style="margin-bottom: 25px; color: #444; font-weight: 300;">My Published Books</h2>

            @* Директно дефинираме GRID структурата тук *@
            <div class="book-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 20px;">

                @if (Model.Books != null && Model.Books.Any())
                {
                    @foreach (var book in Model.Books)
                    {
                        <div class="book-card" style="display: flex; flex-direction: column; background: #fff; border: 1px solid #eee; border-radius: 10px; overflow: hidden; transition: 0.3s; height: 100%;">

                            @* Контейнер за малка корица *@
                            <div style="width: 100%; height: 200px; background: #f4f4f4;">
                                <img src="@book.CoverImageUrl"
                                     onerror="this.src='/images/covers/default.jpg'"
                                     alt="@book.Title"
                                     style="width: 100%; height: 100%; object-fit: cover;">
                            </div>

                            @* Инфо секция *@
                            <div style="padding: 10px; text-align: center; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between;">
                                <h4 style="font-size: 0.9rem; margin: 5px 0; color: #333; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@book.Title">
                                    @book.Title
                                </h4>


                                <a asp-action="Details" asp-controller="Book" asp-route-id="@book.BookID"
                                   style="text-decoration: none; color: #88c1f1; font-weight: bold; font-size: 0.85rem; border-top: 1px solid #f9f9f9; padding-top: 8px;">
                                    Details
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p style="grid-column: 1 / -1; color: #999; font-style: italic;">No books added yet.</p>
                }
            </div>
        </section>
<script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
<script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const logoutBtn = document.getElementById('logoutBtn');
        if (logoutBtn) {
            logoutBtn.addEventListener('click', function (e) {
                e.preventDefault(); 
                
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Account/Logout';
                document.body.appendChild(form);
                form.submit();
            });
        }
    });
</script>


</body>
</html>