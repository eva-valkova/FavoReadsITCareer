@using Microsoft.AspNetCore.Identity
@using FavoReads.Controllers
@model FavoReads.Models.Book
@using System.Security.Claims
@inject SignInManager<IdentityUser> SignInManager

@{
    Layout = null;
    var averageRating = ViewBag.AverageRating ?? 0.0;

    var reviews = ViewBag.Reviews as IEnumerable<FavoReads.Models.BookListReader>;
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Title | FavoRead</title>
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/book.css">
</head>
<body>
    <header>
        <nav>
            <div class="menu">
                <img src="~/images/Logo.svg" class="logo" alt="logo">
                @if (SignInManager.IsSignedIn(User))
                {
                    <a href="javascript:void(0)" id="logoutBtn" class="nav-icon"><ion-icon name="log-out-outline"></ion-icon></a>

                    @* Търсачка *@
                    <form action="/Book/Search" method="get" style="display: inline-flex; align-items: center;">
                        <input type="text" name="query" placeholder="Търсене...">
                        <button type="submit" style="background:none; border:none; cursor:pointer; color: white; margin-left: -30px;">
                            <ion-icon name="search-outline"></ion-icon>
                        </button>
                    </form>

                    <span class="user-greeting">Hello, @User.Identity.Name!</span>
                }
                <a class="active nav-icon" href="/"><ion-icon name="home-outline"></ion-icon></a>
            </div>
        </nav>
    </header>

    <main class="container book-details-page" style="padding: 40px 20px;">
        <div class="book-main-info" style="display: flex; gap: 40px; margin-bottom: 50px;">
            @* 1. Корица *@
            <div class="book-cover-side">
                <img src=@(Model.CoverImageUrl) alt="@Model.Title"
                     style="width: 250px; border-radius: 10px; box-shadow: 0 10px 20px rgba(0,0,0,0.2);">
                @{
                    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
                    // Проверяваме дали в списъка с ревюта (който вече си заредила по-горе)
                    // има запис, който принадлежи на текущия потребител
                    bool alreadyRead = reviews != null && reviews.Any(r => r.Reader?.IdentityUserId == userId);
                }

                @if (User.Identity.IsAuthenticated && User.IsInRole("Reader"))
                {
                    if (alreadyRead)
                    {
                        @* Ако вече е в базата данни, показваме този надпис *@
                        <div style="margin-top: 20px; padding: 12px; background: #f8f9fa; color: #28a745; border: 1px solid #d4edda; border-radius: 8px; text-align: center; font-weight: bold; display: flex; align-items: center; justify-content: center; gap: 8px;">
                            <ion-icon name="checkmark-done-circle" style="font-size: 1.5rem;"></ion-icon>
                            Read
                        </div>
                    }
                    else
                    {
                        @* Ако потребителят още не е маркирал книгата, показваме бутона *@
                        <form asp-action="AddReview" asp-controller="Review" method="get" style="margin-top: 20px;">
                            <input type="hidden" name="id" value="@Model.BookID" />
                            <button type="submit" class="btn btn-add" style="width: 100%; padding: 12px; font-weight: bold; background-color: #88c1f1; color: white; border: none; border-radius: 8px; cursor: pointer;">
                                Mark as read <i class="fa-solid fa-plus"></i>
                            </button>
                        </form>
                    }
                }
            </div>

            @* 2. Текст и детайли *@
            <div class="book-text-side" style="flex: 1;">
                <h1 style="font-size: 2.5rem; margin-bottom: 5px;">@Model.Title</h1>
                <h3 style="color: #555; font-weight: 400; margin-bottom: 15px;">от @Model.Author.FirstName @Model.Author.LastName</h3>

                @* Рейтинг *@
                <div class="rating-display" style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px;">
                    <div class="stars" style="color: #ffcccc; font-size: 1.2rem;">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <i class="fa-@(i <= Math.Round(averageRating) ? "solid" : "regular") fa-star"></i>
                        }
                    </div>
                    <span style="font-weight: bold; font-size: 1.1rem;">@averageRating.ToString("F1")</span>
                </div>

                <p class="book-description" style="line-height: 1.6; font-size: 1.05rem; color: #333;">
                    @Model.Description
                </p>
            </div>
            @*
                @if (User.IsInRole("Reader"))
            {
                <section class="add-review-section" style="margin-top: 30px; background: #fdfdfd; padding: 20px; border-radius: 10px; border: 1px solid #eee;">
                    <h3>Review</h3>
                    <form asp-controller="Review" asp-action="AddReview" method="post">
                        <input type="hidden" name="BookId" value="@Model.BookID" />

                        <div class="form-group">
                            <label>Rating:</label>
                            <select name="Rating" class="form-control" style="width: 100px; margin-bottom: 10px;">
                                <option value="5">5 ★</option>
                                <option value="4">4 ★</option>
                                <option value="3">3 ★</option>
                                <option value="2">2 ★</option>
                                <option value="1">1 ★</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <textarea name="Review" class="form-control" placeholder="Write a review..." rows="4" required></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary" style="margin-top: 15px;">Post Review</button>
                    </form>
                </section>
            }*@
        </div>

        <hr style="border: 0; border-top: 1px solid #eee; margin: 40px 0;">

        @* 3. Секция с ревюта *@
        <section class="book-reviews">
            <h2 style="margin-bottom: 30px;">Reviews</h2>

            @if (reviews == null || !reviews.Any())
            {
                <p>Enjoyed this book? Be the first to review it!</p>
            }
            else
            {
                @if (reviews == null || !reviews.Any())
                {
                    <p>Enjoyed this book? Be the first to review it!</p>
                }
                else
                {
                    @foreach (var review in reviews)
                    {
                        <div class="review-card" style="display: flex; gap: 20px; margin-bottom: 30px; background: #fafafa; padding: 20px; border-radius: 10px;">
                            <img src="~/images/avatars/user-default.png" style="width: 50px; height: 50px; border-radius: 50%;">
                            <div style="flex: 1;">
                                <div style="display: flex; justify-content: space-between;">
                                    @* Използваме Reader обекта, за да вземем името *@
                                    <strong>@review.Reader?.FirstName @review.Reader?.LastName</strong>

                                    <div class="stars" style="color: #ffcccc; font-size: 0.9rem;">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            @* Използваме BookRating полето *@
                                            <i class="fa-@(i <= review.BookRating ? "solid" : "regular") fa-star"></i>
                                        }
                                    </div>
                                </div>
                                @* Използваме твоето поле BookReview *@
                                <p style="margin-top: 10px; color: #444;">@review.BookReview</p>
                            </div>
                        </div>
                    }
                }
            }
        </section>
    </main>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const logoutBtn = document.getElementById('logoutBtn');
            if (logoutBtn) {
                logoutBtn.addEventListener('click', function (e) {
                    e.preventDefault();

                    const form = document.createElement('form');
                    form.method = 'POST';
                    form.action = '/Account/Logout';
                    document.body.appendChild(form);
                    form.submit();
                });
            }
        });
    </script>
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</body>
</html>