@model FavoReads.DTOs.CreateReviewDto
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    Layout = null;
    var bookTitle = ViewBag.BookTitle;
    var bookId = ViewBag.BookId;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add review | FavoRead</title>
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/addReview.css">
    <style>
      
    </style>
</head>
<body>
    <header>
        <nav>
            <div class="menu">
                <img src="~/images/Logo.svg" class="logo" alt="logo">
                @if (SignInManager.IsSignedIn(User))
                {
                    <a href="javascript:void(0)" id="logoutBtn" class="nav-icon"><ion-icon name="log-out-outline"></ion-icon></a>
                    <span class="user-greeting">Здравей, @User.Identity.Name!</span>
                }
                <a class="active nav-icon" href="/"><ion-icon name="home-outline"></ion-icon></a>
            </div>
        </nav>
    </header>

    <main class="container">
        <div class="add-review-container">
            <h2 style="margin-bottom: 10px; color: #ccc; font-weight: 300;">Add review window</h2>
            <h4 style="margin-bottom: 30px; color: #555;">Книга: @bookTitle</h4>
            
            <form asp-action="AddReview" asp-controller="Review" method="post">
                <input type="hidden" name="BookId" value="@bookId" />

                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                    @* Избор на звезди *@
                    <div class="rating-stars">
                        <input type="radio" id="star5" name="Rating" value="5" /><label for="star5" title="5 звезди">★</label>
                        <input type="radio" id="star4" name="Rating" value="4" /><label for="star4" title="4 звезди">★</label>
                        <input type="radio" id="star3" name="Rating" value="3" /><label for="star3" title="3 звезди">★</label>
                        <input type="radio" id="star2" name="Rating" value="2" /><label for="star2" title="2 звезди">★</label>
                        <input type="radio" id="star1" name="Rating" value="1" /><label for="star1" title="1 звезда">★</label>
                    </div>

                    @* Бутон Add *@
                    <button type="submit" class="btn btn-add" style="padding: 12px 40px; background: none; border: 1px solid #ddd; color: #88c1f1; font-weight: bold; font-size: 1.1rem; border-radius: 8px;">
                        Add
                    </button>
                </div>

                @* Заглавие на ревюто *@
                <input asp-for="ReviewTitle" class="input-box" placeholder="Add title...">
                
                @* Текст на ревюто *@
                <textarea asp-for="ReviewText" class="input-box textarea-box" placeholder="Add description..."></textarea>
            </form>
        </div>
    </main>

    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</body>
</html>