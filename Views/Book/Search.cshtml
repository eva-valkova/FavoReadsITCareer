@model IEnumerable<FavoReads.Models.Book>
@using Microsoft.AspNetCore.Identity
@using FavoReads.Controllers
@using FavoReads.Models
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search Results | FavoRead</title>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/book.css">
</head>

<body>
<header>
    <nav>
        <div class="menu">
            <img src="~/images/Logo.svg" class="logo" alt="logo">
            
            <div class="nav-right-side">

            @if (SignInManager.IsSignedIn(User))
            {
                <span class="user-greeting">Hello, @User.Identity.Name!</span>
                
                @*SearchBar*@
                <form asp-controller="Book" asp-action="Search" method="get" class="search-form">
                       <input type="text" name="query" placeholder="Search..." value="@ViewBag.SearchQuery">
                       <button type="submit" style="background:none; border:none; cursor:pointer; display:flex; align-items:center; padding:0;">
                       <ion-icon name="search-outline" style="color:#5CCCF9; font-size:22px;"></ion-icon>
                       </button>

                    @* Атрибутът name="query" свързва текста с контролера *@
                    <input type="text" name="query" placeholder="Search..." value="@ViewBag.SearchQuery">
                </form>

                @*Profile*@
                @if (User.IsInRole("Author"))
                {
                    <a href="/Author/Index" class="nav-icon"><ion-icon name="person-circle-outline"></ion-icon></a>
                }
                else if (User.IsInRole("Reader"))
                {
                    <a href="/Reader/Index" class="nav-icon"><ion-icon name="person-circle-outline"></ion-icon></a>
                }

                @*Log out*@
                <a href="javascript:void(0)" id="logoutBtn" class="nav-icon"><ion-icon name="log-out-outline"></ion-icon></a>
            }
            else
            {
                <a href="/Account/Login">Log in</a>
                <a href="/Account/Register">Sign in</a>
            }

            <a class="active nav-icon" href="/"><ion-icon name="home-outline"></ion-icon></a>
        </div>
        </div>
    </nav>
</header>

<main style="padding: 20px;">
    <h2>Results for: "@ViewBag.SearchQuery"</h2>

    @if (Model == null || !Model.Any())
    {
        <p>No books found matching your search.</p>
    }
    else
    {
            <div class="book-grid">
                @foreach (var book in Model)
                {
                    <div class="book-card">
                        @* Добавяне на корицата *@
                        <img src=@book.CoverImageUrl
                             alt="@book.Title"
                             onerror="this.src='/images/covers/default.jpg'"
                             style="width: 150px; height: 220px; object-fit: cover; border-radius: 5px; display: block; margin: 0 auto 10px;">

                        <h4>@book.Title</h4>

                        @if (book.Author != null)
                        {
                            <p>Author: @book.Author.FirstName @book.Author.LastName</p>
                        }

                        <a asp-action="Details" asp-controller="Book" asp-route-id="@book.BookID" class="btn btn-info">Details</a>
                    </div>
                }
            </div>
    }

    <br />
    <a asp-action="Index" asp-controller="Book" class="btn btn-secondary">Back</a>
</main>

<script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
<script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>

<script>
    // Logout логиката
    document.getElementById('logoutBtn')?.addEventListener('click', function (e) {
        e.preventDefault();
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/Account/Logout';
        document.body.appendChild(form);
        form.submit();
    });
</script>

</body>
</html>