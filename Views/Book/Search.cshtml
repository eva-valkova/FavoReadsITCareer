@model IEnumerable<FavoReads.Models.Book>

@{
    ViewData["Title"] = "Резултати от търсенето";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home | FavoRead</title>
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/book.css">
</head>

<body>
<header>
        <nav>
            <div class="menu">
                <img src="~/images/Logo.svg" class="logo" alt="logo">
                @if (SignInManager.IsSignedIn(User))
                {
                    <a href="javascript:void(0)" id="logoutBtn" class="nav-icon"><ion-icon name="log-out-outline"></ion-icon></a>
                    <a href="/Author/Index" class="nav-icon"><ion-icon name="person-circle-outline"></ion-icon></a>
                    <a href="/Book/Search" class="nav-icon"><ion-icon name="search-outline"></ion-icon></a>
                    <input type="text" placeholder="Search...">
                    <span class="user-greeting">Hello, @User.Identity.Name!</span>
                }
                else
                {
                    <a href="/Account/Login">Log in</a>
                    <a href="/Account/Register">Sign in</a>
                }

                <a class="active nav-icon" href="/"><ion-icon name="home-outline"></ion-icon></a>
            </div>
        </nav>
    </header>
<h2>Резултати за: "@ViewBag.SearchQuery"</h2>

@if (!Model.Any())
{
    <p>No found books.</p>
}
else
{
    <div class="book-grid">
        @foreach (var book in Model)
        {
            <div class="book-card">
                <h4>@book.Title</h4>
                <p>Автор: @book.Author.FirstName @book.Author.LastName</p>
                <a asp-action="Details" asp-route-id="@book.BookID" class="btn btn-info">Виж повече</a>
            </div>
        }
    </div>
}

<a asp-action="Index" class="btn btn-secondary">Back</a>
</body>